// SPDX-License-Identifier: MPL-2.0
//
// The configuration of Renovate.
//
// Renovate keeps the versions of the actions that the workflows use up to
// date. The versions live in `workflows/lib.nix`, and the custom manager
// below is the one that finds them there: Dependabot cannot, because its
// `github-actions` ecosystem only reads workflow files, which are rendered
// from those definitions.
//
// The post-upgrade task renders the workflows again, so that the pull request
// carries the files of `.github/workflows/` as well, and the check of the
// repository passes.
//
// The commands of the post-upgrade tasks are allowed by the administrator of
// Renovate, which is the workflow of `.github/workflows/renovate.yml`.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Only the actions of the workflows. The inputs of the flakes are updated
  // by Dependabot.
  "enabledManagers": [ "custom.regex" ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "The versions of the actions that the workflows use",
      "managerFilePatterns": [ "/^workflows\\/lib\\.nix$/" ],
      "matchStrings": [
        "\"(?<depName>[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+)@(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^(?<version>.*)$",
      "versioningTemplate": "github-actions",
      "depTypeTemplate": "action"
    }
  ],

  "postUpgradeTasks": {
    "commands": [ "nix run .#render-workflows" ],
    "executionMode": "branch",
    "fileFilters": [ "workflows/**", ".github/workflows/**" ]
  }
}
