// SPDX-License-Identifier: MPL-2.0
//
// The configuration of Renovate.
//
// The application that updates the actions of the workflows reads their
// versions from `workflows/lib.nix`, where the custom manager below finds
// them. Dependabot cannot do it, because its `github-actions` ecosystem only
// reads workflow files, and those are rendered from the definitions.
//
// The manager is the only one that runs, so that the application does not
// open pull requests against the rendered files. It cannot render them
// either, because the commands of the post-upgrade tasks are blocked on the
// hosted application: the workflow of the CI renders them for its pull
// requests instead.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Only the actions of the workflows. The inputs of the flakes are updated
  // by Dependabot.
  "enabledManagers": [ "custom.regex" ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "The versions of the actions that the workflows use",
      "managerFilePatterns": [ "/^workflows\\/lib\\.nix$/" ],
      "matchStrings": [
        "\"(?<depName>[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+)@(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^(?<version>.*)$",
      "versioningTemplate": "github-actions",
      "depTypeTemplate": "action"
    }
  ]
}
